#!/bin/bash
# morphe - Android App Patcher CLI
# Usage: morphe [gui|cli|patch|install|update|help]

set -e

MORPHE_HOME="${HOME}/.local/share/morphe-desktop"
MORPHE_JAR="${MORPHE_HOME}/morphe-desktop-all.jar"
PATCHES_DIR="${MORPHE_HOME}/patches"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

err()  { echo -e "${RED}[morphe]${NC} $*"; }
ok()   { echo -e "${GREEN}[morphe]${NC} $*"; }
warn() { echo -e "${YELLOW}[morphe]${NC} $*"; }
info() { echo -e "${BLUE}[morphe]${NC} $*"; }

check_java() {
    command -v java &>/dev/null || { err "Java not found. Install: sudo pacman -S jdk21-openjdk"; exit 1; }
    local v; v=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | cut -d'.' -f1)
    [ "$v" -ge 21 ] || { err "Java 21+ required (found $v)"; exit 1; }
}

check_jar() {
    [ -f "$MORPHE_JAR" ] || { err "Morphe not installed. Run: morphe install"; exit 1; }
}

cmd_gui()   { info "Starting GUI..."; exec java -jar "$MORPHE_JAR" "$@"; }
cmd_cli()   { info "Running CLI..."; exec java -jar "$MORPHE_JAR" "$@"; }

cmd_patch() {
    local apk="${1:?Usage: morphe patch <apk> [patches] [output]}"
    local patches="${2:-$(find "$PATCHES_DIR" -name '*.mpp' 2>/dev/null | head -1)}"
    local out="${3:-.}"

    [ -f "$apk" ] || { err "File not found: $apk"; exit 1; }
    [ -n "$patches" ] && [ -f "$patches" ] || { err "No patches found in $PATCHES_DIR"; exit 1; }

    info "Patching $apk ..."
    java -jar "$MORPHE_JAR" patch -p "$patches" "$apk" -o "$out"
    ok "Done!"
}

cmd_install() {
    local apk="${1:?Usage: morphe install <apk>}"
    [ -f "$apk" ] || { err "File not found: $apk"; exit 1; }
    command -v adb &>/dev/null || { err "ADB not found. Install: sudo pacman -S android-tools"; exit 1; }
    info "Installing $apk ..."
    adb install "$apk"
    ok "Installed!"
}

cmd_update() {
    info "Updating patches..."
    local rel
    rel=$(curl -sf https://api.github.com/repos/MorpheApp/morphe-patches/releases/latest | grep -o '"tag_name": "[^"]*"' | cut -d'"' -f4)
    [ -n "$rel" ] || { err "Could not fetch latest release"; exit 1; }
    local v="${rel#v}"
    curl -fL -o "$PATCHES_DIR/patches.mpp" \
        "https://github.com/MorpheApp/morphe-patches/releases/download/${rel}/patches-${v}.mpp" --progress-bar
    ok "Patches updated to $rel"
}

cmd_help() {
    echo -e "${BLUE}Morphe Desktop${NC} - Android App Patcher"
    echo ""
    echo -e "${GREEN}Usage:${NC} morphe <command> [args]"
    echo ""
    echo -e "${GREEN}Commands:${NC}"
    echo "  gui                Launch GUI"
    echo "  cli [args]         Run CLI"
    echo "  patch <apk> [p] [o] Patch APK (patches & output optional)"
    echo "  install <apk>      Install APK via ADB"
    echo "  update             Update patches"
    echo "  help               Show this help"
    echo "  version            Show version"
    echo ""
    echo -e "${GREEN}Examples:${NC}"
    echo "  morphe                          # Launch GUI"
    echo "  morphe patch youtube.apk        # Patch YouTube"
    echo "  morphe install youtube-patched.apk"
    echo "  morphe update"
    echo ""
    echo -e "${GREEN}Install:${NC}   ./install.sh"
    echo -e "${GREEN}Uninstall:${NC} ./uninstall.sh"
}

cmd_version() {
    [ -f "$MORPHE_JAR" ] && java -jar "$MORPHE_JAR" --version 2>/dev/null || echo "Not installed"
}

# --- main ---
check_java
check_jar

case "${1:-gui}" in
    gui)      shift; cmd_gui "$@" ;;
    cli)      shift; cmd_cli "$@" ;;
    patch)    shift; cmd_patch "$@" ;;
    install)  shift; cmd_install "$@" ;;
    update)   cmd_update ;;
    version)  cmd_version ;;
    help|-h|--help) cmd_help ;;
    *)        # If it's a file, open in GUI; else error
              [ -f "$1" ] && cmd_gui "$@" || { err "Unknown command: $1"; cmd_help; exit 1; } ;;
esac
